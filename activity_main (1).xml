<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <SurfaceView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.logcam.app.GuideView
        android:id="@+id/guideView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.logcam.app.LevelView
        android:id="@+id/levelView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <View
        android:id="@+id/recBorder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/rec_border"
        android:visibility="gone" />

    <View
        android:id="@+id/focusRing"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:background="@drawable/focus_ring"
        android:visibility="gone" />

    <!-- top left: what you are recording -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="18dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:shadowColor="#99000000"
            android:shadowRadius="4"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvInfo2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:shadowColor="#99000000"
            android:shadowRadius="4"
            android:textColor="#B3FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- top centre: lock badge -->
    <TextView
        android:id="@+id/tvLock"
        android:tag="accent"
        style="@style/pill"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="18dp"
        android:clickable="false"
        android:text="AE / AF LOCK"
        android:textColor="#FFC23C"
        android:visibility="gone" />

    <!-- top right: timer, settings, record -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="28dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvTimer"
            style="@style/pill"
            android:layout_marginEnd="12dp"
            android:clickable="false"
            android:textColor="#FF6B6B"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/btnSettings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_pill_round"
            android:padding="11dp"
            android:src="@drawable/ic_tune" />

        <ImageView
            android:id="@+id/btnRecord"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:scaleType="fitXY"
            android:src="@drawable/rec_idle" />
    </LinearLayout>

    <!-- left: exposure controls -->
    <LinearLayout
        android:id="@+id/exposureControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="24dp"
        android:orientation="vertical">

        <TextView android:id="@+id/pillIso" style="@style/pillSide" />
        <TextView android:id="@+id/pillShutter" style="@style/pillSide" />
        <TextView android:id="@+id/pillWb" style="@style/pillSide" />
        <TextView android:id="@+id/pillFocus" style="@style/pillSide" />
        <TextView android:id="@+id/pillEv" style="@style/pillSide" />
        <TextView android:id="@+id/pillZoom" style="@style/pillSide" />
    </LinearLayout>

    <!-- bottom centre: slider + lens levels -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="16dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/sliderBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvAuto"
                style="@style/pill"
                android:minWidth="64dp"
                android:text="AUTO" />

            <SeekBar
                android:id="@+id/sbMain"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvSlider"
                style="@style/pill"
                android:clickable="false"
                android:minWidth="84dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/zoomChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal" />
    </LinearLayout>

    <!-- last recording / library button -->
    <ImageView
        android:id="@+id/btnLibrary"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_pill_round"
        android:padding="13dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_library" />

    <!-- contextual vertical camera control, shown for ISO and zoom -->
    <LinearLayout
        android:id="@+id/verticalControlPanel"
        android:layout_width="76dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_panel"
        android:elevation="8dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingTop="7dp"
        android:paddingEnd="4dp"
        android:paddingBottom="7dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvVerticalTitle"
            android:tag="accent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="6dp"
            android:text="ISO"
            android:textColor="#FFC23C"
            android:textSize="11sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/btnZoomPlus"
            android:layout_width="34dp"
            android:layout_height="29dp"
            android:background="@drawable/bg_pill"
            android:gravity="center"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:visibility="gone" />

        <com.logcam.app.VerticalValueSlider
            android:id="@+id/verticalSlider"
            android:layout_width="66dp"
            android:layout_height="176dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/btnZoomMinus"
            android:layout_width="34dp"
            android:layout_height="29dp"
            android:background="@drawable/bg_pill"
            android:gravity="center"
            android:text="−"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnVerticalAuto"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="3dp"
            android:background="@drawable/bg_pill"
            android:gravity="center"
            android:text="AUTO"
            android:textColor="#FFFFFF"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- settings sheet, docked to the right -->
    <LinearLayout
        android:id="@+id/settingsPanel"
        android:layout_width="360dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/bg_panel"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:clickable="true"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingTop="14dp"
            android:paddingEnd="20dp"
            android:paddingBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="Settings"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/btnSetClose"
                style="@style/pill"
                android:text="Done" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="true"
            android:clipToPadding="true"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="20dp">

                <TextView style="@style/section" android:tag="accent" android:text="VIDEO" />
            <LinearLayout android:id="@+id/rowRes" style="@style/row">
                <TextView style="@style/rowLabel" android:text="Resolution" />
                <TextView android:id="@+id/vRes" style="@style/rowValue" />
            </LinearLayout>
            <LinearLayout android:id="@+id/rowGamut" style="@style/row">
                <TextView style="@style/rowLabel" android:text="Gamut" />
                <TextView android:id="@+id/vGamut" style="@style/rowValue" />
            </LinearLayout>
            <LinearLayout android:id="@+id/rowStab" style="@style/row">
                <TextView style="@style/rowLabel" android:text="Stabilization" />
                <TextView android:id="@+id/vStab" style="@style/rowValue" />
            </LinearLayout>
            <LinearLayout android:id="@+id/rowTen" style="@style/row">
                <TextView style="@style/rowLabel" android:text="10-bit HDR source" />
                <TextView android:id="@+id/vTen" style="@style/rowValue" />
            </LinearLayout>
            <LinearLayout android:id="@+id/rowAudio" style="@style/row">
                <TextView style="@style/rowLabel" android:text="Audio" />
                <TextView android:id="@+id/vAudio" style="@style/rowValue" />
            </LinearLayout>
            <LinearLayout android:id="@+id/rowOutputRec709" style="@style/row">
                <TextView style="@style/rowLabel" android:text="Rec.709 recording output" />
                <Switch
                    android:id="@+id/vOutputRec709"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:showText="true"
                    android:textOn="709"
                    android:textOff="LOG"
                    android:checked="false"
                    android:contentDescription="Toggle Rec.709 recording output"
                    android:thumbTint="#FFFFFFFF"
                    android:trackTint="#66777777" />
            </LinearLayout>

                <TextView style="@style/section" android:tag="accent" android:text="MONITORING" />
            <LinearLayout android:id="@+id/rowAssist" style="@style/row">
                <TextView style="@style/rowLabel" android:text="Rec.709 preview" />
                <TextView android:id="@+id/vAssist" style="@style/rowValue" />
            </LinearLayout>
            <LinearLayout android:id="@+id/rowGuide" style="@style/row">
                <TextView style="@style/rowLabel" android:text="Frame guide" />
                <TextView android:id="@+id/vGuide" style="@style/rowValue" />
            </LinearLayout>
            <LinearLayout android:id="@+id/rowGrid" style="@style/row">
                <TextView style="@style/rowLabel" android:text="Grid lines" />
                <TextView android:id="@+id/vGrid" style="@style/rowValue" />
            </LinearLayout>
            <LinearLayout android:id="@+id/rowLevel" style="@style/row">
                <TextView style="@style/rowLabel" android:text="Level" />
                <TextView android:id="@+id/vLevel" style="@style/rowValue" />
            </LinearLayout>

                <TextView style="@style/section" android:tag="accent" android:text="INTERFACE" />
            <LinearLayout android:id="@+id/rowControlPosition" style="@style/row">
                <TextView style="@style/rowLabel" android:text="Control position" />
                <TextView android:id="@+id/vControlPosition" style="@style/rowValue" />
            </LinearLayout>
            <LinearLayout android:id="@+id/rowAccent" style="@style/row">
                <TextView style="@style/rowLabel" android:text="Interface color" />
                <TextView android:id="@+id/vAccent" style="@style/rowValue" />
            </LinearLayout>

                <TextView style="@style/section" android:tag="accent" android:text="ZOOM" />
            <LinearLayout android:id="@+id/rowZoomSpeed" style="@style/row">
                <TextView style="@style/rowLabel" android:text="Zoom speed" />
                <TextView android:id="@+id/vZoomSpeed" style="@style/rowValue" />
            </LinearLayout>

                <TextView style="@style/section" android:tag="accent" android:text="ORIENTATION" />
            <LinearLayout android:id="@+id/rowRot" style="@style/row">
                <TextView style="@style/rowLabel" android:text="Fix orientation" />
                <TextView android:id="@+id/vRot" style="@style/rowValue" />
            </LinearLayout>

                <TextView style="@style/section" android:tag="accent" android:text="APP" />
            <LinearLayout android:id="@+id/rowCheckUpdates" style="@style/row">
                <TextView style="@style/rowLabel" android:text="Check for updates" />
                <TextView
                    android:id="@+id/vCheckUpdates"
                    style="@style/rowValue"
                    android:text="Check now" />
            </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- recordings library -->
    <LinearLayout
        android:id="@+id/libraryPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF0F0F10"
        android:clickable="true"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="0dp">

            <TextView
                android:id="@+id/libTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />

            <LinearLayout
                android:id="@+id/libActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView android:id="@+id/btnLibShare" style="@style/pill" android:text="Share" />
                <TextView android:id="@+id/btnLibExport" style="@style/pill" android:text="Export" />
                <TextView android:id="@+id/btnLibDelete" style="@style/pill" android:text="Delete" android:textColor="#FF6B6B" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnLibClose"
                style="@style/pill"
                android:layout_marginStart="12dp"
                android:text="Close" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvLibEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="40dp"
            android:text="No recordings yet"
            android:textColor="#99FFFFFF"
            android:textSize="14sp"
            android:visibility="gone" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:nestedScrollingEnabled="false">

            <LinearLayout
                android:id="@+id/libraryList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="8dp" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>
